# Copy to .env for local development. In Cloudflare Pages, set these under
# Settings > Environment variables instead.
PUBLIC_GTM_ID=
PUBLIC_ADOBE_TAGS_URL=
PUBLIC_GA4_ID=
PUBLIC_SHOW_EVENT_LOG=true
SITE_URL=
# Adobe Web SDK: mock (default) | cancel | live | off
PUBLIC_WEBSDK_MODE=mock
# Only needed for live mode
PUBLIC_WEBSDK_DATASTREAM_ID=
PUBLIC_WEBSDK_ORG_ID=
PUBLIC_WEBSDK_EDGE_DOMAIN=
