---
// Every content page in every section (src/content/pages), in both languages.
// index.md is the section's hub: its text, then a list of the section's pages.
// The French route (src/pages/fr/[section]/[...slug].astro) renders this file.
import { render, getEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { siteMeta } from '../../config/tags';
import { sectionById } from '../../config/sections';
import { getPages, getSectionPages, parseId, pagePath, englishId, formatDate, isoDate, wordCount, type Page } from '../../lib/content';
import { graph, article, breadcrumbs } from '../../lib/seo';
import { LOCALE, langFromPath, localize, tr } from '../../i18n';

export async function getStaticPaths() {
  return (await getPages('en')).map((entry) => {
    const { section, slug } = parseId(entry.id);
    return { params: { section, slug: slug === 'index' ? undefined : slug }, props: { entry } };
  });
}

const { entry } = Astro.props as { entry: Page };
const { Content } = await render(entry);
const d = entry.data;
const lang = langFromPath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
const { section, slug } = parseId(entry.id);
const isHub = slug === 'index';
const sec = sectionById(section)!;
const sectionName = tr(lang, sec.title.en, sec.title.fr);
const path = l(pagePath(section, slug));
const children = isHub ? (await getSectionPages(section, lang)).filter((p) => parseId(p.id).slug !== 'index') : [];

// Analytics values come from the English page whatever the language: a page
// is one row in reports, and page.language splits the versions.
const en = lang === 'fr' ? (await getEntry('pages', englishId(section, slug)))?.data ?? d : d;
const pageData = {
  page: { name: `${section}:${isHub ? 'home' : slug}`, type: isHub ? 'section front' : 'article', section, siteName: siteMeta.blogName },
  content: {
    id: slug === 'index' ? section : slug,
    title: en.title,
    category: en.category,
    tags: en.tags,
    platform: en.platform,
    publishDate: isoDate(d.pubDate),
    updatedDate: d.updatedDate ? isoDate(d.updatedDate) : undefined,
    author: siteMeta.owner,
    wordCount: wordCount(entry.body),
  },
};
const crumbs = [{ name: tr(lang, 'Home', 'Accueil'), path: l('/') }, { name: sectionName, path: l(`/${section}/`) }];
---
<BlogLayout title={`${d.title} — ${siteMeta.blogName}`} description={d.description} pageData={pageData}
  ogType="article" published={d.pubDate} modified={d.updatedDate}
  jsonLd={graph(
    article({ path, title: d.title, description: d.description, published: d.pubDate, modified: d.updatedDate, tags: d.tags, section: sectionName, wordCount: wordCount(entry.body), inLanguage: LOCALE[lang] }),
    breadcrumbs(isHub ? crumbs : [...crumbs, { name: d.title, path }]),
  )}>
  <article class="post">
    <div class="blog-wrap">
      <header class="post-head">
        <p class="crumbs">{isHub ? sectionName : <a href={l(`/${section}/`)}>{sectionName}</a>}</p>
        <h1>{d.title}</h1>
        {!isHub && (
          <div class="post-meta">
            <time datetime={isoDate(d.updatedDate ?? d.pubDate)}>{d.updatedDate && d.updatedDate > d.pubDate ? `${tr(lang, 'Updated', 'Mis à jour le')} ${formatDate(d.updatedDate, lang)}` : formatDate(d.pubDate, lang)}</time>
            <span>{d.category}</span>
          </div>
        )}
      </header>
      <div class="post-body">
        <Content />
      </div>
      {children.length > 0 && (
        <nav class="section-pages" aria-label={tr(lang, 'Pages in this section', 'Pages de cette section')}>
          <h2>{tr(lang, 'In this section', 'Dans cette section')}</h2>
          <ul>
            {children.map((p) => (
              <li><a href={l(pagePath(section, parseId(p.id).slug))}>{p.data.title}</a><p>{p.data.description}</p></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>

  <script>
    import { trackScrollDepth } from '../../scripts/scroll';
    trackScrollDepth(document.querySelector('.post-body'));
  </script>
</BlogLayout>
