---
import ShopLayout from '../../../layouts/ShopLayout.astro';
import { langFromPath, localize, tr } from '../../../i18n';

const lang = langFromPath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
// value = what payment_type sends to analytics (English in both languages)
const methods = [
  { value: 'credit card', label: tr(lang, 'Credit card (demo, no card details asked)', 'Carte de crédit (démo, aucun numéro demandé)') },
  { value: 'gift card', label: tr(lang, 'Gift card (demo)', 'Carte-cadeau (démo)') },
  { value: 'pay in store', label: tr(lang, 'Pay at pickup', 'Payer à la cueillette') },
];
---
<ShopLayout title={tr(lang, 'Checkout: payment', 'Caisse : paiement')} pageType="checkout" pageName="shop:checkout:payment" extra={{ checkout: { step: 2, stepName: 'payment' } }} checkoutStep={2}>
  <div class="shop-wrap">
    <h1 class="page-title">{tr(lang, 'Payment', 'Paiement')}</h1>
    <div class="empty" data-empty hidden>
      <p>{tr(lang, 'Your cart is empty, so there’s nothing to pay for.', 'Votre panier est vide : il n’y a rien à payer.')}</p>
      <div class="actions"><a class="btn" href={l('/shop/cart/')}>{tr(lang, 'Go to cart', 'Voir le panier')}</a></div>
    </div>

    <div class="cart-layout" data-checkout>
      <form class="pay-form" novalidate autocomplete="off">
        <p class="notice">{tr(lang,
          'This demo never asks for card numbers. Pick a method to set payment_type in the data layer.',
          'Cette démo ne demande jamais de numéro de carte. Choisissez un mode pour définir payment_type dans la couche de données.')}</p>
        <fieldset class="options">
          <legend>{tr(lang, 'Payment method', 'Mode de paiement')}</legend>
          {methods.map((m, i) => (
            <label class="option">
              <input type="radio" name="method" value={m.value} checked={i === 0} />
              <span>{m.label}</span>
            </label>
          ))}
        </fieldset>
        <div class="qty-row">
          <button class="btn btn-go" type="submit">{tr(lang, 'Place order', 'Passer la commande')}</button>
          <a class="btn btn-ghost" href={l('/shop/checkout/')}>{tr(lang, 'Back to shipping', 'Retour à la livraison')}</a>
        </div>
      </form>

      <aside class="summary" aria-label={tr(lang, 'Order summary', 'Résumé de la commande')}>
        <h2>{tr(lang, 'Order summary', 'Résumé de la commande')}</h2>
        <dl data-totals></dl>
      </aside>
    </div>
  </div>

  <script>
    import { addPaymentInfo, createOrder, readSession, writeSession, type ShippingTier } from '../../../scripts/commerce';
    import { renderSummary, guardEmpty } from '../../../scripts/checkout-ui';
    import { lp } from '../../../scripts/lab';

    const form = document.querySelector<HTMLFormElement>('.pay-form')!;
    const tier = readSession<ShippingTier>('lab-tier', 'standard');

    if (!guardEmpty(document.querySelector('[data-checkout]')!, document.querySelector('[data-empty]')!)) {
      renderSummary(document.querySelector('[data-totals]')!, tier);
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const method = form.querySelector<HTMLInputElement>('input[name="method"]:checked')!.value;
        addPaymentInfo(method, tier);
        writeSession('lab-order', createOrder(tier, method));
        // Brief pause so tags listening for add_payment_info can send before the page changes
        setTimeout(() => (location.href = lp('/shop/checkout/confirmation/')), 300);
      });
    }
  </script>
</ShopLayout>
