---
// French route: renders the French version of each post with the English
// post page component. Posts live in src/content/blog/fr/ under the same slug.
import Page from '../../blog/[...slug].astro';
import { getPosts, slugOf } from '../../../lib/blog';
export async function getStaticPaths() {
  const posts = await getPosts('fr');
  return posts.map((post) => ({ params: { slug: slugOf(post.id) }, props: { post } }));
}
---
<Page {...Astro.props} />
