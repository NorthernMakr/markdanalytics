---
// Analytics practice section. index.md renders at /practice/, other files at
// /practice/<file-name>/. French versions live in src/content/practice/fr/
// and render at /fr/practice/. Same layout as blog posts, plus a section menu.
import { render, getEntry, type CollectionEntry } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { siteMeta } from '../../config/tags';
import { formatDate, isoDate, wordCount, getPractice, slugOf } from '../../lib/blog';
import { graph, article, breadcrumbs } from '../../lib/seo';
import { LOCALE, langFromPath, localize, tr } from '../../i18n';

type Entry = CollectionEntry<'practice'>;
export async function getStaticPaths() {
  const pages = await getPractice('en');
  return pages.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry, pages },
  }));
}

const { entry, pages } = Astro.props as { entry: Entry; pages: Entry[] };
const { Content } = await render(entry);
const d = entry.data;
const lang = langFromPath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
const slug = slugOf(entry.id);
const isIndex = slug === 'index';
const pagePath = l(isIndex ? '/practice/' : `/practice/${slug}/`);
const sectionName = tr(lang, 'Analytics practice', 'Pratique d’analytique');
const others = pages.filter((p) => slugOf(p.id) !== 'index').sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// Analytics values come from the English page (see the blog post page).
const en = lang === 'fr' ? (await getEntry('practice', slug))?.data ?? d : d;
const pageData = {
  page: {
    name: isIndex ? 'practice:index' : `practice:${slug}`,
    type: isIndex ? 'section front' : 'article',
    section: 'practice',
    siteName: siteMeta.blogName,
  },
  content: {
    id: slug,
    title: en.title,
    category: en.category,
    tags: en.tags,
    platform: d.platform,
    publishDate: isoDate(d.pubDate),
    author: siteMeta.owner,
    wordCount: wordCount(entry.body),
  },
};
---
<BlogLayout title={`${d.title} — ${siteMeta.blogName}`} description={d.description} pageData={pageData}
  ogType="article" published={d.pubDate} modified={d.updatedDate}
  jsonLd={graph(
    article({ path: pagePath, title: d.title, description: d.description, published: d.pubDate, modified: d.updatedDate, tags: d.tags, section: sectionName, wordCount: wordCount(entry.body), inLanguage: LOCALE[lang] }),
    breadcrumbs(isIndex
      ? [{ name: tr(lang, 'Home', 'Accueil'), path: l('/') }, { name: sectionName, path: l('/practice/') }]
      : [{ name: tr(lang, 'Home', 'Accueil'), path: l('/') }, { name: sectionName, path: l('/practice/') }, { name: d.title, path: pagePath }]),
  )}>
  <article class="post">
    <div class="blog-wrap">
      <header class="post-head">
        {!isIndex && <p class="crumbs"><a href={l('/practice/')}>{sectionName}</a></p>}
        <h1>{d.title}</h1>
        <div class="post-meta">
          <time datetime={isoDate(d.pubDate)}>{d.updatedDate ? `${tr(lang, 'Updated', 'Mis à jour le')} ${formatDate(d.updatedDate, lang)}` : formatDate(d.pubDate, lang)}</time>
          <span>{d.category}</span>
        </div>
      </header>
      <div class="post-body">
        <Content />
      </div>
      {isIndex && others.length > 0 && (
        <nav class="practice-pages" aria-label={tr(lang, 'Pages in this section', 'Pages de cette section')}>
          <h2>{tr(lang, 'In this section', 'Dans cette section')}</h2>
          <ul>{others.map((p) => <li><a href={l(`/practice/${slugOf(p.id)}/`)}>{p.data.title}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </article>

  <script>
    import { trackScrollDepth } from '../../scripts/scroll';
    trackScrollDepth(document.querySelector('.post-body'));
  </script>
</BlogLayout>
