---
import BlogLayout from '../layouts/BlogLayout.astro';
import { siteMeta } from '../config/tags';
import { getPosts, formatDate, isoDate } from '../lib/blog';
import { graph } from '../lib/seo';

const posts = (await getPosts()).slice(0, 5);

const pageData = {
  page: { name: 'home', type: 'home', section: 'home', siteName: siteMeta.blogName },
};

// The hero shows this page's own data object, as the tag managers receive it.
const specimen = {
  event: 'page_data_ready',
  page: { ...pageData.page, path: '/', language: siteMeta.language },
  user: { loginStatus: 'guest' },
};
const highlighted = JSON.stringify(specimen, null, 2)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/("[^"]+")(\s*:)/g, '<span class="k">$1</span>$2')
  .replace(/(:\s*)("[^"]*")/g, '$1<span class="s">$2</span>');
---
<BlogLayout title={`${siteMeta.blogName} — analytics implementation notes`} pageData={pageData} jsonLd={graph()}>
  <section class="hub-hero">
    <div class="blog-wrap">
      <div>
        <h1>Analytics implementation, worked out in public.</h1>
        <p>{siteMeta.blogTagline}</p>
      </div>
      <figure style="margin:0">
        <pre class="specimen" aria-label="This page's data layer object"><code set:html={highlighted} /></pre>
        <figcaption class="specimen-caption">This page, as GTM and Adobe Tags see it. Open the event log (bottom right) to watch it live.</figcaption>
      </figure>
    </div>
  </section>

  <section class="hub-section">
    <div class="blog-wrap">
      <h2>Latest notes</h2>
      <ul class="post-list">
        {posts.map((p) => (
          <li>
            <time datetime={isoDate(p.data.pubDate)}>{formatDate(p.data.pubDate)}</time>
            <div>
              <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="hub-section">
    <div class="blog-wrap">
      <h2>Test sites</h2>
      <div class="hub-cols">
        <article class="lab-card">
          <h3>Taiga Supply Co. (demo store)</h3>
          <p>A pretend outdoor-gear shop with a full purchase path. Nothing is sold and no details are collected.</p>
          <ol>
            <li><a href="/shop/">Store home</a></li>
            <li><a href="/shop/catalog/">Catalog</a></li>
            <li><a href="/shop/product/tidepool-daypack/">Product detail</a></li>
            <li><a href="/shop/cart/">Cart</a></li>
            <li><a href="/shop/checkout/">Checkout: shipping</a></li>
            <li><a href="/shop/checkout/payment/">Checkout: payment</a></li>
            <li><a href="/shop/checkout/confirmation/">Order confirmation</a></li>
          </ol>
          <p class="events">view_item_list · select_item · view_item · add_to_cart · remove_from_cart · view_cart · begin_checkout · add_shipping_info · add_payment_info · purchase · view_promotion · select_promotion</p>
        </article>
        <article class="lab-card">
          <h3>Balsam Daily (demo media site)</h3>
          <p>A pretend local news site with a self-hosted video player wired for media tracking.</p>
          <ol>
            <li><a href="/media/">Media home</a></li>
            <li><a href="/media/article/ferry-schedule-shakeup/">Article with video</a></li>
            <li><a href="/media/article/night-market-returns/">Article, text only</a></li>
          </ol>
          <p class="events">video_start · video_progress · video_complete · video_pause · article scroll depth · teaser clicks</p>
        </article>
      </div>
      <p class="lab-note">Both sites also run Adobe's Web SDK against a stand-in Edge Network on this domain. <a href="/blog/testing-adobe-web-sdk-without-an-adobe-account/">How the mock Web SDK setup works</a>.</p>
    </div>
  </section>
</BlogLayout>
