---
import BlogLayout from '../layouts/BlogLayout.astro';
import { siteMeta } from '../config/tags';
import { getPages, parseId, pagePath, formatDate, isoDate } from '../lib/content';
import { graph } from '../lib/seo';
import { LOCALE, langFromPath, localize, tr } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
const pages = await getPages(lang);
// Most recently published or updated pages inside sections
const recent = pages.filter((p) => parseId(p.id).slug !== 'index')
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf())
  .slice(0, 5);

const pageData = {
  page: { name: 'home', type: 'home', section: 'home', siteName: siteMeta.blogName },
};

// The hero shows this page's own data object, as the tag managers receive it.
// browserLanguage is filled in by the browser, so the example shows a placeholder
// and the script below swaps in the visitor's real value.
const specimen = {
  event: 'page_data_ready',
  page: { ...pageData.page, path: l('/'), language: LOCALE[lang] },
  user: { loginStatus: 'guest', browserLanguage: '…', languageMatch: true },
};
const highlighted = JSON.stringify(specimen, null, 2)
  .replace(/&/g, '&amp;').replace(/</g, '&lt;')
  .replace(/("[^"]+")(\s*:)/g, '<span class="k">$1</span>$2')
  .replace(/(:\s*)("[^"]*")/g, '$1<span class="s">$2</span>')
  .replace('<span class="s">"…"</span>', '<span class="s" data-bl>"…"</span>')
  .replace(/("languageMatch"<\/span>: )true/, '$1<span data-lm>true</span>');
---
<BlogLayout title={`${siteMeta.blogName} — ${tr(lang, siteMeta.blogTagline, siteMeta.blogTaglineFr).replace(/\.$/, '')}`} pageData={pageData} jsonLd={graph()}>
  <section class="home-intro">
    <div class="blog-wrap home-intro-grid">
      <h1>{tr(lang, 'Digital Analytics: Practices & Approaches', 'Analytique numérique : pratiques et approches')}</h1>
      <div class="home-intro-text">
      <p>{tr(lang,
        'Greetings and salutations! I’m Mark Dykeman, and I’ve spent my career in digital analytics and on websites and mobile apps. With this site I’m trying to do three things:',
        'Salutations! Je suis Mark Dykeman, et j’ai fait carrière en analytique numérique ainsi que sur des sites Web et des applications mobiles. Avec ce site, j’essaie de faire trois choses :')}</p>
      <ul class="home-goals">
        <li><strong>{tr(lang, 'Pull what I know into one place.', 'Rassembler ce que je sais.')}</strong> {tr(lang,
          'Organize my digital analytics knowledge and my preferred implementation approach into a coherent whole.',
          'Organiser mes connaissances en analytique numérique et mon approche de mise en œuvre préférée en un tout cohérent.')}</li>
        <li><strong>{tr(lang, 'Build a site that’s measured from day one.', 'Bâtir un site mesuré dès le premier jour.')}</strong> {tr(lang,
          'Analytics is usually added after a website is built. What happens when the two aren’t separated? I’m not sure it makes a difference, but I’d like to see if there are unanticipated benefits.',
          'D’habitude, l’analytique s’ajoute une fois le site Web construit. Qu’arrive-t-il quand les deux ne sont pas séparés? Je ne suis pas certain que ça change quelque chose, mais j’aimerais voir s’il y a des avantages imprévus.')}</li>
        <li><strong>{tr(lang, 'Indulge my love of AI.', 'Me faire plaisir avec l’IA.')}</strong> {tr(lang,
          'I’m using it to build, manage and write much of this site. I expect bumps and pitfalls, and I’m looking forward to learning from them. You get good by doing.',
          'Je m’en sers pour construire, gérer et rédiger une bonne partie de ce site. Je m’attends à des embûches et j’ai hâte d’en tirer des leçons. C’est en forgeant qu’on devient forgeron.')}</li>
      </ul>
      </div>
      <figure class="home-specimen">
        <pre class="specimen" aria-label={tr(lang, 'This page’s data layer object', 'L’objet de couche de données de cette page')}><code set:html={highlighted} /></pre>
        <figcaption class="specimen-caption">{tr(lang,
          'This page, as GTM and Adobe Tags see it, including your browser’s language. Open the event log (bottom right) to watch it live.',
          'Cette page telle que la voient GTM et Adobe Tags, y compris la langue de votre navigateur. Ouvrez le journal (en bas à droite) pour la voir en direct.')}</figcaption>
      </figure>
      <div class="home-intro-rest">
      <h2>{tr(lang, 'Done So Far', 'Réalisé jusqu’ici')}</h2>
      <ul class="home-goals">
        <li>{tr(lang, 'Built the site in English and French, to demonstrate and test ', 'Construit le site en anglais et en français, pour montrer et tester ')}<a href={l('/process/multilingual-sites/')}>{tr(lang, 'how I handle multilingual sites', 'ma façon de gérer les sites multilingues')}</a>.</li>
        <li>{tr(lang, 'Built two demo sites, a ', 'Construit deux sites démo, un ')}<a href={l('/media/')}>{tr(lang, 'media site', 'site média')}</a>{tr(lang, ' and an ', ' et une ')}<a href={l('/shop/')}>{tr(lang, 'e-commerce store', 'boutique en ligne')}</a>{tr(lang,
          ', as a canvas for analytics implementation and experimentation.',
          ', comme terrain d’essai pour la mise en œuvre et l’expérimentation en analytique.')}</li>
        <li>{tr(lang,
          'Built the whole site to work well on phones, be accessible, and be friendly to search engines and AI answer engines (SEO and AEO).',
          'Conçu l’ensemble pour bien fonctionner sur mobile, être accessible et bien se présenter aux moteurs de recherche et aux moteurs de réponse IA (SEO et AEO).')}</li>
        <li>{tr(lang, 'Started building out my ', 'Commencé à bâtir mon ')}<a href={l('/process/adobe-analytics-approach/')}>{tr(lang, 'Adobe Analytics implementation approach', 'approche de mise en œuvre d’Adobe Analytics')}</a>{tr(lang, ', including several important ', ', y compris plusieurs ')}<a href={l('/implementation/')}>{tr(lang, 'artifacts', 'livrables importants')}</a>.</li>
      </ul>
      </div>
    </div>
  </section>

  <section class="hub-section">
    <div class="blog-wrap">
      <h2>{tr(lang, 'The demo sites', 'Les sites démo')}</h2>
      <div class="hub-cols">
        <article class="lab-card">
          <h3>Taiga Supply Co. ({tr(lang, 'demo store', 'boutique démo')})</h3>
          <p>{tr(lang,
            'A pretend outdoor-gear shop with a full purchase path. Nothing is sold and no details are collected.',
            'Une fausse boutique de plein air avec un parcours d’achat complet. Rien n’est vendu et aucune donnée n’est recueillie.')}</p>
          <ol>
            <li><a href={l('/shop/')}>{tr(lang, 'Store home', 'Accueil de la boutique')}</a></li>
            <li><a href={l('/shop/catalog/')}>{tr(lang, 'Catalog', 'Catalogue')}</a></li>
            <li><a href={l('/shop/product/tidepool-daypack/')}>{tr(lang, 'Product detail', 'Fiche produit')}</a></li>
            <li><a href={l('/shop/cart/')}>{tr(lang, 'Cart', 'Panier')}</a></li>
            <li><a href={l('/shop/checkout/')}>{tr(lang, 'Checkout: shipping', 'Caisse : livraison')}</a></li>
            <li><a href={l('/shop/checkout/payment/')}>{tr(lang, 'Checkout: payment', 'Caisse : paiement')}</a></li>
            <li><a href={l('/shop/checkout/confirmation/')}>{tr(lang, 'Order confirmation', 'Confirmation de commande')}</a></li>
          </ol>
          <p class="events">view_item_list · select_item · view_item · add_to_cart · remove_from_cart · view_cart · begin_checkout · add_shipping_info · add_payment_info · purchase · view_promotion · select_promotion</p>
        </article>
        <article class="lab-card">
          <h3>Balsam Daily ({tr(lang, 'demo media site', 'site média démo')})</h3>
          <p>{tr(lang,
            'A pretend local news site with a self-hosted video player wired for media tracking.',
            'Un faux site de nouvelles locales avec un lecteur vidéo hébergé ici, branché pour le suivi des médias.')}</p>
          <ol>
            <li><a href={l('/media/')}>{tr(lang, 'Media home', 'Accueil du site média')}</a></li>
            <li><a href={l('/media/article/ferry-schedule-shakeup/')}>{tr(lang, 'Article with video', 'Article avec vidéo')}</a></li>
            <li><a href={l('/media/article/night-market-returns/')}>{tr(lang, 'Article, text only', 'Article, texte seulement')}</a></li>
          </ol>
          <p class="events">video_start · video_progress · video_complete · video_pause · {tr(lang, 'article scroll depth', 'profondeur de défilement')} · {tr(lang, 'teaser clicks', 'clics sur les accroches')} · language_switch</p>
        </article>
      </div>
      <p class="lab-note">{tr(lang,
        'Both sites also run Adobe’s Web SDK against a stand-in Edge Network on this domain.',
        'Les deux sites font aussi tourner le Web SDK d’Adobe contre une doublure de l’Edge Network sur ce domaine.')} <a href={l('/data-quality/testing-adobe-web-sdk-without-an-adobe-account/')}>{tr(lang, 'How the mock Web SDK setup works', 'Comment fonctionne le Web SDK simulé')}</a>.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="blog-wrap">
      <h2>{tr(lang, 'Recently updated', 'Mis à jour récemment')}</h2>
      <ul class="post-list">
        {recent.map((p) => {
          const { section, slug } = parseId(p.id);
          return (
            <li>
              <time datetime={isoDate(p.data.updatedDate ?? p.data.pubDate)}>{formatDate(p.data.updatedDate ?? p.data.pubDate, lang)}</time>
              <div>
                <h3><a href={l(pagePath(section, slug))}>{p.data.title}</a></h3>
                <p>{p.data.description}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <script>
    // Show the visitor's real browser language in the specimen.
    const u = (window as any).labPage?.user;
    const bl = document.querySelector('[data-bl]');
    const lm = document.querySelector('[data-lm]');
    if (u && bl) bl.textContent = JSON.stringify(u.browserLanguage);
    if (u && lm) lm.textContent = String(u.languageMatch);
  </script>
</BlogLayout>
