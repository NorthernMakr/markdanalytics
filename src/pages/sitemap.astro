---
// Human-readable sitemap. Search engines use /sitemap.xml instead; this page
// lists everything, including the demo sites that are kept out of search.
import BlogLayout from '../layouts/BlogLayout.astro';
import { siteMeta } from '../config/tags';
import { getIndexablePages } from '../lib/indexable';
import { graph, breadcrumbs } from '../lib/seo';
import { products, productText } from '../data/products';
import { articles, articleText } from '../data/articles';
import { langFromPath, localize, tr } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
const pages = (await getIndexablePages()).filter((p) => p.lang === lang);
const practice = pages.filter((p) => p.kind === 'practice');
const posts = pages.filter((p) => p.kind === 'post');
const title = tr(lang, 'Sitemap', 'Plan du site');

const pageData = {
  page: { name: 'site:sitemap', type: 'article list', section: 'site', siteName: siteMeta.blogName },
};
---
<BlogLayout title={`${title} — ${siteMeta.blogName}`}
  description={tr(lang,
    'Every page on markdanalytics.ca: notes, the analytics practice section, and the demo store and news site used for testing.',
    'Toutes les pages de markdanalytics.ca : notes, section pratique d’analytique, et la boutique et le site de nouvelles démo qui servent aux tests.')}
  pageData={pageData} jsonLd={graph(breadcrumbs([{ name: tr(lang, 'Home', 'Accueil'), path: l('/') }, { name: title, path: l('/sitemap/') }]))}>
  <article class="post">
    <div class="blog-wrap">
      <header class="post-head">
        <h1>{title}</h1>
      </header>
      <div class="post-body sitemap">
        <h2>{tr(lang, 'Main pages', 'Pages principales')}</h2>
        <ul>
          <li><a href={l('/')}>{tr(lang, 'Home', 'Accueil')}</a></li>
          <li><a href={l('/blog/')}>Notes</a></li>
          <li><a href={l('/practice/')}>{tr(lang, 'Analytics practice', 'Pratique d’analytique')}</a></li>
          <li><a href={l('/contact/')}>Contact</a></li>
          <li><a href={l('/site-notes/')}>{tr(lang, 'Notes on this site’s development', 'Notes sur la conception de ce site')}</a></li>
          <li><a href={localize('/sitemap/', lang === 'en' ? 'fr' : 'en')} hreflang={lang === 'en' ? 'fr-CA' : 'en-CA'}>{tr(lang, 'Plan du site (français)', 'Sitemap (English)')}</a></li>
        </ul>

        <h2>{tr(lang, 'Analytics practice', 'Pratique d’analytique')}</h2>
        <ul>{practice.map((p) => <li><a href={p.path}>{p.title}</a></li>)}</ul>

        <h2>Notes</h2>
        <ul>{posts.map((p) => <li><a href={p.path}>{p.title}</a></li>)}</ul>

        <h2>{tr(lang, 'Demo store: Taiga Supply Co.', 'Boutique démo : Taiga Supply Co.')}</h2>
        <p>{tr(lang, 'A fictional store for testing ecommerce tracking. Not listed in search engines.', 'Une boutique fictive pour tester le suivi du commerce en ligne. Absente des moteurs de recherche.')}</p>
        <ul>
          <li><a href={l('/shop/')}>{tr(lang, 'Store home', 'Accueil de la boutique')}</a></li>
          <li><a href={l('/shop/catalog/')}>{tr(lang, 'Catalog', 'Catalogue')}</a></li>
          {products.map((p) => <li><a href={l(`/shop/product/${p.slug}/`)}>{productText(p, lang).name}</a></li>)}
          <li><a href={l('/shop/cart/')}>{tr(lang, 'Cart', 'Panier')}</a></li>
          <li><a href={l('/shop/checkout/')}>{tr(lang, 'Checkout', 'Caisse')}</a></li>
        </ul>

        <h2>{tr(lang, 'Demo news site: Balsam Daily', 'Site de nouvelles démo : Balsam Daily')}</h2>
        <p>{tr(lang, 'A fictional news site for testing article and video tracking. Not listed in search engines.', 'Un site de nouvelles fictif pour tester le suivi des articles et des vidéos. Absent des moteurs de recherche.')}</p>
        <ul>
          <li><a href={l('/media/')}>{tr(lang, 'Balsam Daily home', 'Accueil de Balsam Daily')}</a></li>
          {articles.map((a) => <li><a href={l(`/media/article/${a.slug}/`)}>{articleText(a, lang).headline}</a></li>)}
        </ul>

        <h2>{tr(lang, 'For machines', 'Pour les machines')}</h2>
        <ul>
          <li><a href="/sitemap.xml">{tr(lang, 'XML sitemap', 'Plan du site XML')}</a> {tr(lang, 'for search engines', 'pour les moteurs de recherche')}</li>
          <li><a href="/rss.xml">{tr(lang, 'RSS feed', 'Fil RSS')}</a></li>
          <li><a href="/llms.txt">llms.txt</a> {tr(lang, 'for AI assistants', 'pour les assistants IA')}</li>
          <li><a href="/robots.txt">robots.txt</a></li>
        </ul>
      </div>
    </div>
  </article>
</BlogLayout>
