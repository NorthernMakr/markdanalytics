---
// Flat product illustrations, so the demo store needs no photography.
import type { ArtKind } from '../data/products';
interface Props { kind: ArtKind; colour: string; label?: string; }
const { kind, colour, label } = Astro.props;
const dark = '#1D3327';
const light = '#F7F9F8';
---
<svg class="product-art" viewBox="0 0 200 200" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} data-colour-target>
  <ellipse cx="100" cy="176" rx="62" ry="7" fill={dark} opacity=".12" />
  {kind === 'pack' && (
    <g>
      <path d="M70 52 q0-22 30-22 q30 0 30 22" fill="none" stroke={dark} stroke-width="7" stroke-linecap="round" />
      <rect x="52" y="48" width="96" height="124" rx="26" fill={colour} class="fill" />
      <rect x="64" y="104" width="72" height="50" rx="14" fill={dark} opacity=".18" />
      <rect x="84" y="66" width="32" height="7" rx="3.5" fill={light} opacity=".85" />
      <line x1="64" y1="118" x2="136" y2="118" stroke={light} stroke-width="3" stroke-dasharray="5 4" opacity=".7" />
    </g>
  )}
  {kind === 'drybag' && (
    <g>
      <rect x="62" y="56" width="76" height="116" rx="22" fill={colour} class="fill" />
      <rect x="56" y="34" width="88" height="22" rx="6" fill={dark} />
      <path d="M70 34 q30 -18 60 0" fill="none" stroke={dark} stroke-width="6" />
      <rect x="62" y="100" width="76" height="10" fill={light} opacity=".6" />
    </g>
  )}
  {kind === 'jacket' && (
    <g>
      <path d="M72 40 L100 52 L128 40 L162 66 L150 98 L138 92 L138 172 L62 172 L62 92 L50 98 L38 66 Z" fill={colour} class="fill" />
      <path d="M86 36 q14 22 28 0" fill={dark} />
      <line x1="100" y1="54" x2="100" y2="172" stroke={dark} stroke-width="4" />
      <rect x="70" y="118" width="20" height="5" rx="2.5" fill={light} opacity=".7" />
      <rect x="110" y="118" width="20" height="5" rx="2.5" fill={light} opacity=".7" />
    </g>
  )}
  {kind === 'beanie' && (
    <g>
      <circle cx="100" cy="46" r="16" fill={colour} class="fill" />
      <path d="M48 136 q0-82 52-82 q52 0 52 82 Z" fill={colour} class="fill" />
      <rect x="44" y="128" width="112" height="36" rx="10" fill={dark} opacity=".85" />
      {[60, 76, 92, 108, 124, 140].map((x) => <line x1={x} y1="134" x2={x} y2="158" stroke={colour} stroke-width="5" stroke-linecap="round" />)}
    </g>
  )}
  {kind === 'tent' && (
    <g>
      <path d="M22 168 L100 48 L178 168 Z" fill={colour} class="fill" />
      <path d="M100 48 L100 168" stroke={dark} stroke-width="4" />
      <path d="M100 96 L72 168 L128 168 Z" fill={dark} opacity=".8" />
      <line x1="100" y1="48" x2="100" y2="30" stroke={dark} stroke-width="4" stroke-linecap="round" />
    </g>
  )}
  {kind === 'lantern' && (
    <g>
      <path d="M78 46 q22 -26 44 0" fill="none" stroke={dark} stroke-width="6" />
      <rect x="66" y="46" width="68" height="16" rx="5" fill={dark} />
      <rect x="72" y="62" width="56" height="88" rx="10" fill="#FFE3A3" />
      <circle cx="100" cy="106" r="16" fill="#FFC145" />
      <rect x="66" y="150" width="68" height="22" rx="6" fill={colour} class="fill" />
    </g>
  )}
  {kind === 'mug' && (
    <g>
      <path d="M128 92 h14 a20 20 0 0 1 0 44 h-14" fill="none" stroke={colour} stroke-width="10" class="stroke" />
      <rect x="52" y="74" width="80" height="98" rx="12" fill={colour} class="fill" />
      <rect x="52" y="74" width="80" height="10" rx="5" fill={dark} />
      <path d="M78 58 q8 -10 0 -20 M100 58 q8 -10 0 -20" fill="none" stroke={dark} stroke-width="4" stroke-linecap="round" opacity=".5" />
    </g>
  )}
  {kind === 'bottle' && (
    <g>
      <rect x="84" y="26" width="32" height="20" rx="6" fill={dark} />
      <path d="M80 46 h40 v14 q16 8 16 24 v80 q0 10-10 10 h-52 q-10 0-10-10 v-80 q0-16 16-24 Z" fill={colour} class="fill" />
      <rect x="64" y="108" width="72" height="24" fill={light} opacity=".75" />
    </g>
  )}
</svg>
