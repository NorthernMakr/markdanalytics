---
import Base, { type PageData } from './Base.astro';
import { siteMeta } from '../config/tags';
import '../styles/blog.css';

interface Props { title: string; description?: string; pageData: PageData; }
const { title, description, pageData } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Notes' },
  { href: '/shop/', label: 'Demo store' },
  { href: '/media/', label: 'Demo media site' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<Base title={title} description={description} pageData={pageData} bodyClass="blog">
  <header class="blog-nav">
    <div class="blog-wrap">
      <a class="blog-logo" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#14213D"/><rect x="7" y="18" width="4" height="7" rx="1" fill="#E9A23B"/><rect x="14" y="12" width="4" height="13" rx="1" fill="#E8ECF2"/><rect x="21" y="7" width="4" height="18" rx="1" fill="#E8ECF2"/></svg>
        {siteMeta.blogName}
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined} data-nav-link={n.label}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="blog-footer">
    <div class="blog-wrap">
      © {new Date().getFullYear()} {siteMeta.owner}. Independent notes, not affiliated with Adobe or Google.
    </div>
  </footer>
</Base>
