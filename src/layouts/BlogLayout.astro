---
import Base, { type PageData } from './Base.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { siteMeta } from '../config/tags';
import { NAV } from '../config/sections';
import { langFromPath, basePath, localize, tr } from '../i18n';
import { getSectionPages, parseId, pagePath } from '../lib/content';
import '../styles/blog.css';

interface Props {
  title: string; description?: string; pageData: PageData;
  noindex?: boolean; robots?: string; ogType?: 'website' | 'article';
  jsonLd?: object; published?: Date; modified?: Date;
}
const { title, description, pageData, ...seo } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const base = basePath(Astro.url.pathname);
const l = (p: string) => localize(p, lang);
// Menu items come from src/config/sections.ts (NAV).
// Fly-outs list every page in a content section, in the hub page's order.
const nav = await Promise.all(NAV.map(async (n) => ({
  href: n.href, label: tr(lang, n.label.en, n.label.fr),
  children: n.children && await Promise.all(n.children.map(async (c) => ({
    href: c.href, label: tr(lang, c.label.en, c.label.fr),
    pages: c.flyoutSection
      ? (await getSectionPages(c.flyoutSection, lang))
          .filter((p) => parseId(p.id).slug !== 'index')
          .map((p) => ({ href: pagePath(c.flyoutSection!, parseId(p.id).slug), label: p.data.title }))
      : undefined,
  }))),
})));
const isCurrent = (href: string) => base.startsWith(href);
const isExact = (href: string) => base === href;
---
<Base title={title} description={description} pageData={pageData} bodyClass="blog" {...seo}>
  <p class="draft-notice" role="note">{tr(lang,
    'Draft: this site is a work in progress. Pages are still being added and revised.',
    'Ébauche : ce site est en construction. Des pages s’ajoutent et se révisent encore.')}</p>
  <header class="blog-nav">
    <div class="blog-wrap">
      <a class="blog-logo" href={l('/')}>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="#14213D"/><rect x="7" y="18" width="4" height="7" rx="1" fill="#E9A23B"/><rect x="14" y="12" width="4" height="13" rx="1" fill="#E8ECF2"/><rect x="21" y="7" width="4" height="18" rx="1" fill="#E8ECF2"/></svg>
        {siteMeta.blogName}
      </a>
      <div class="blog-tools">
        <a class="blog-contact" href={l('/contact/')} aria-current={base === '/contact/' ? 'page' : undefined}>{tr(lang, 'Contact', 'Me joindre')}</a>
        <LangSwitch class="blog-lang" />
      </div>
      <nav class="blog-menu" aria-label={tr(lang, 'Main', 'Principal')}>
        <ul>
          {nav.map((n, i) => n.children ? (
            <li class="has-sub" data-current={isCurrent(n.href) || n.children.some((c) => isCurrent(c.href)) ? '' : undefined}>
              <span class="nav-split">
                <a href={l(n.href)} aria-current={isExact(n.href) ? 'page' : undefined}>{n.label}</a>
                <button type="button" class="nav-sub-toggle" aria-expanded="false" aria-controls={`nav-sub-${i}`}
                  aria-label={tr(lang, `${n.label}: show menu`, `${n.label} : afficher le menu`)}>
                  <svg class="nav-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </span>
              <ul class="nav-sub" id={`nav-sub-${i}`}>
                {n.children.map((c) => (
                  <li class={c.pages?.length ? 'has-fly' : undefined}>
                    <a href={l(c.href)} aria-current={isExact(c.href) ? 'page' : undefined}>
                      {c.label}{c.pages?.length && <svg class="fly-caret" viewBox="0 0 6 10" aria-hidden="true"><path d="M1 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                    </a>
                    {c.pages?.length && (
                      <ul class="nav-fly">
                        {c.pages.map((pg) => (
                          <li><a href={l(pg.href)} aria-current={isExact(pg.href) ? 'page' : undefined}>{pg.label}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a href={l(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <script>
    // Menu drop-downs: open on click or tap (and on hover with a mouse, in CSS).
    // Escape or a click elsewhere closes them.
    const toggles = [...document.querySelectorAll<HTMLButtonElement>('.nav-sub-toggle')];
    const closeAll = (except?: HTMLButtonElement) =>
      toggles.forEach((t) => { if (t !== except) t.setAttribute('aria-expanded', 'false'); });
    toggles.forEach((t) => t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') !== 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(open));
    }));
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('.has-sub')) closeAll();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
      closeAll();
      open?.focus();
    });
  </script>
  <footer class="blog-footer">
    <div class="blog-wrap">
      <p>© {new Date().getFullYear()} {siteMeta.owner}. {tr(lang, 'Independent notes, not affiliated with Adobe or Google.', 'Notes indépendantes, sans lien avec Adobe ni Google.')}</p>
      <nav aria-label={tr(lang, 'Footer', 'Pied de page')}>
        <ul class="footer-links">
          <li><a href={l('/contact/')}>{tr(lang, 'Contact', 'Contact')}</a></li>
          <li><a href={l('/site-notes/')}>{tr(lang, 'How this site was built', 'Comment ce site a été construit')}</a></li>
          <li><a href={l('/sitemap/')}>{tr(lang, 'Sitemap', 'Plan du site')}</a></li>
          <li><a href={l('/rss.xml')}>RSS</a></li>
        </ul>
      </nav>
    </div>
  </footer>
</Base>
