---
// Shared shell for every page on the site.
//
// Load order in <head> matters for analytics, so it's fixed here:
//   1. dataLayer / adobeDataLayer are created and this page's data is pushed
//   2. Adobe Tags (Launch) embed, if configured
//   3. Google Tag Manager / gtag.js, if configured
// That way both tag managers find page data already waiting when they start.
import { tags, siteMeta } from '../config/tags';
import { checkPage, GA4_EVENTS, ADOBE_EVENTS, FORBIDDEN_KEYS } from '../config/analytics';
import { DEFAULT_IMAGE } from '../lib/seo';
import { LOCALE, OG_LOCALE, langFromPath, basePath, localize, otherLang, tr } from '../i18n';
import EventLog from '../components/EventLog.astro';
import LangSwitch from '../components/LangSwitch.astro';
import '../styles/base.css';

export interface PageData {
  page: {
    name: string;
    type: string;
    section: string;
    siteName: string;
    [key: string]: unknown;
  };
  content?: Record<string, unknown>;
  [key: string]: unknown;
}

interface Props {
  title: string;
  description?: string;
  pageData: PageData;
  bodyClass?: string;
  demoBanner?: string;
  /** Keep this page out of search results and the sitemap (demo sites, 404). */
  noindex?: boolean;
  /** Full robots value, overriding noindex (e.g. "noindex, nofollow"). */
  robots?: string;
  /** Open Graph type: "website" by default, "article" for posts. */
  ogType?: 'website' | 'article';
  /** schema.org structured data for this page (see src/lib/seo.ts). */
  jsonLd?: object;
  /** Article dates for Open Graph. */
  published?: Date;
  modified?: Date;
}

const {
  title, description: descProp, pageData, bodyClass = '', demoBanner,
  noindex = !!demoBanner, robots, ogType = 'website', jsonLd, published, modified,
} = Astro.props;
// Language comes from the URL: /fr/... is French, everything else English.
const lang = langFromPath(Astro.url.pathname);
const description = descProp ?? (lang === 'fr' ? siteMeta.blogTaglineFr : siteMeta.blogTagline);
const enPath = basePath(Astro.url.pathname);
const frPath = localize(enPath, 'fr');
const robotsContent = robots ?? (noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large');
const ogImage = new URL(DEFAULT_IMAGE.url, Astro.site).toString();
const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';

const fullData = {
  ...pageData,
  page: {
    ...pageData.page,
    // The real address, in the page's language (/fr/boutique/ on French pages).
    // page.name is the English key that combines both versions in reports.
    path: Astro.url.pathname,
    language: LOCALE[lang], // language of the page itself
    environment: import.meta.env.PROD ? 'production' : 'development',
  },
  user: { loginStatus: 'guest' },
};

// Enforce the site's analytics conventions: a page that breaks them fails the build.
checkPage(fullData.page, Astro.url.pathname);
const conventions = JSON.stringify({ ga4: GA4_EVENTS, adobe: ADOBE_EVENTS, forbidden: FORBIDDEN_KEYS });

// JSON for an inline script; escape "<" so content can't close the tag.
const pageJson = JSON.stringify(fullData).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang={LOCALE[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- The same page in each language, for search engines -->
    <link rel="alternate" hreflang="en-CA" href={new URL(enPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="fr-CA" href={new URL(frPath, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site).toString()} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={siteMeta.owner} />
    <link rel="alternate" type="application/rss+xml" title={`${siteMeta.blogName} (RSS)`} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Sharing previews (Open Graph, also read by LinkedIn, Slack, X) -->
    <meta property="og:site_name" content={siteMeta.blogName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLang(lang)]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(DEFAULT_IMAGE.width)} />
    <meta property="og:image:height" content={String(DEFAULT_IMAGE.height)} />
    <meta property="og:image:alt" content={DEFAULT_IMAGE.alt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {(modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={siteMeta.owner} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Structured data for search engines and AI answer engines -->
    {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}

    <!-- 0. Adobe Web SDK + bridge from adobeDataLayer events to sendEvent -->
    {tags.webSdk.mode !== 'off' && (
      <>
        <script is:inline set:html={`window.labWebSdkConfig = ${JSON.stringify(tags.webSdk)};`} />
        <script is:inline src="/lab/websdk-bridge.js"></script>
      </>
    )}

    <!-- 1. Data layers + page data (must come before any tag manager) -->
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      window.adobeDataLayer = window.adobeDataLayer || [];
      window.labPage = ${pageJson};
      /* The visitor's browser language, read at run time (the page language is fixed at build time) */
      (function (u) {
        var bl = (navigator.languages && navigator.languages[0]) || navigator.language || '';
        u.browserLanguage = bl;
        u.languageMatch = !!bl && bl.slice(0, 2).toLowerCase() === window.labPage.page.language.slice(0, 2);
      })(window.labPage.user);
      /* Outside production, warn when a push breaks the conventions in src/config/analytics.ts */
      var labRules = ${conventions};
      var labCheck = function (layer, list, evt) {
        if (window.labPage.page.environment === 'production' || !evt) return;
        if (list.indexOf(evt.event) < 0) console.warn('[analytics conventions] ' + layer + ': unregistered event "' + evt.event + '"');
        (function scan(o, path) {
          if (!o || typeof o !== 'object') return;
          Object.keys(o).forEach(function (k) {
            if (labRules.forbidden.indexOf(k) >= 0) console.warn('[analytics conventions] ' + layer + ': personal-data key "' + path + k + '" in "' + evt.event + '"');
            scan(o[k], path + k + '.');
          });
        })(evt, '');
      };
      window.lab = {
        /* GA4 / GTM: clear the previous ecommerce object before each ecommerce push */
        ga4: function (evt) {
          labCheck('dataLayer', labRules.ga4, evt);
          if (evt && evt.ecommerce) window.dataLayer.push({ ecommerce: null });
          window.dataLayer.push(evt);
        },
        /* Adobe Client Data Layer, also forwarded to the Web SDK bridge when it's on */
        adobe: function (evt) {
          labCheck('adobeDataLayer', labRules.adobe, evt);
          window.adobeDataLayer.push(evt);
          if (window.labWebSdk) window.labWebSdk(evt);
        }
      };
      window.lab.ga4(Object.assign({ event: 'page_data_ready' }, window.labPage));
      window.lab.adobe(Object.assign({ event: 'page loaded' }, window.labPage));
    `} />

    <!-- 2. Adobe Experience Platform Tags (Launch) -->
    {tags.adobeTagsUrl && <script is:inline src={tags.adobeTagsUrl} async></script>}

    <!-- 3. Google Tag Manager -->
    {tags.gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${tags.gtmId}');`} />
    )}

    <!-- Optional: gtag.js direct -->
    {tags.ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${tags.ga4Id}`}></script>
        <script is:inline set:html={`function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${tags.ga4Id}');`} />
      </>
    )}
  </head>
  <body class={bodyClass}>
    {tags.gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${tags.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}

    {demoBanner && (
      <div class="lab-ribbon" role="note">
        <span>{demoBanner}</span>
        <span class="lab-ribbon-links">
          <a href={localize('/', lang)}>{tr(lang, 'Back to', 'Retour à')} {siteMeta.blogName}</a>
          <LangSwitch />
        </span>
      </div>
    )}

    <slot />

    {tags.showEventLog && <EventLog lang={lang} />}
  </body>
</html>
