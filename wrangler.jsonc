// Cloudflare deployment settings. Cloudflare runs `npm run build`, then
// `npx wrangler deploy`, which publishes the static site built into ./dist
// plus the small Worker in src/worker.ts (the mock Adobe Edge endpoint).
{
  "name": "markdanalytics",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /ee/* goes to the Worker; everything else is served as static files.
    "run_worker_first": ["/ee/*"]
  }
}
